	frame.Add(new MySprite(SpriteType.TEXTURE, "SquareSimple", size / 2, size, new Color(0, 0, 40)));
	frame.Add(MySprite.CreateText("${2:Привет}", "Debug", Color.White, 1f, TextAlignment.CENTER));
	$0
}]]></content>
