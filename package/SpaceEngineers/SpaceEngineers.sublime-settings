{
	// Папка Bin64 игры. Пусто — искать автоматически (Steam по умолчанию и библиотеки Steam).
	"game_bin64": "",

	// Порт SeHelper (он же адрес веб-симулятора http://127.0.0.1:<порт>/)
	"helper_port": 8765,

	// Пауза после правки перед проверкой кода, мс
	"lint_delay_ms": 500,

	// Показывать текст ошибки прямо в конце строки
	"inline_errors": true,

	// Загружать скрипт в симулятор при каждом сохранении (горячая перезагрузка)
	"load_into_simulator_on_save": true,

	// Считать скриптом SE любой .cs (иначе — по признакам: MyGridProgram, GridTerminalSystem, Main(string) …)
	"treat_all_cs_as_se": false,

	// «Скопировать для игры»: выкидывать строки-комментарии // (экономит лимит в 100 000 символов)
	"copy_strip_comments": false,

	// Останавливать SeHelper, когда Sublime выгружает плагин
	"stop_helper_on_exit": true,
}
